{erl_opts, [debug_info]}.
{deps, [
  {jiffy, "2.0.2"},
  %% The riakc package on hex (2.5.3, 2017) no longer compiles on OTP 27+
  %% (`maybe` is now a keyword, and the removed queue() type is used).
  %% OpenRiak maintains the client; it isn't published to hex, so it's a
  %% git dep, pinned to an exact commit by rebar.lock.
  {riakc, {git, "https://github.com/OpenRiak/riak-erlang-client.git",
           {branch, "openriak-3.4"}}}
]}.

{relx, [{release, { blog_post, "0.1.0" },
         [blog_post,
          sasl]},

        {overlay_vars, "config/default.config"},
        {overlay, [
                   {template, "etc/sys.config", "{{output_dir}}/releases/{{release_version}}/sys.config"}]},
        {dev_mode, true},
        {include_erts, false},	
        {extended_start_script, true}
]}.

{profiles, [
	   {prod, [{relx, [{overlay_vars, "config/prod.config"}, {dev_mode, false},
                            {include_erts, true}]}]
            },
	   {stage, [{relx, [{overlay_vars, "config/stage.config"}, {dev_mode, false},
                            {include_erts, true}]}]
            },
	   {dev, [{relx, [{overlay_vars, "config/dev.config"}, {dev_mode, false},
                            {include_erts, true}]}]
            }]
}.
